<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template configuration for V5VPN client.

  Copy this file to setting.xml (project root) and replace
  the placeholder credentials below. The DES-CBC key/IV used to
  decode stored passwords lives in internal/crypto/crypto.go; this
  template uses synthetic ciphertext ("Demo-Pass-2026!" encrypted
  with that routine) for the demo user "alice" so you can verify
  the loader round-trips. The username/password below are
  synthetic fixtures for tests and local development only.

  NEVER commit a populated setting.xml to version control. The file
  is listed in .gitignore.
-->
<SETTING_INFO>
  <COMMON offRelogin="0" HideToTray="1" LoginDebug="0" language="0" remember="1" autologin="0" trayNotify="0"></COMMON>
  <GATEWAY LastUseGateway="demo-gateway">
    <Gateway0 Name="demo-gateway" Ip="203.0.113.10" Port="443" algo="0">
      <!--
        authtype: 0 = password login, 1 = certificate login, 2 = anonymous
        certtype: 0 = local file cert (.p12/.pfx in certs/), 1 = Windows system store
        certautologin: 1 = auto-login with certificate
        certid: optional selected certificate ID or SHA1 fingerprint
      -->
      <USER LastUserName="alice" authtype="0" certtype="0" certautologin="0">
        <!-- Replace Name with base64("your-username") and Pwd with the
             DES-CBC ciphertext of your password (see crypto.go).
             The values below are synthetic test fixtures. -->
        <User0 Name="YWxpY2U=" Pwd="oP+Rz3ZCmFL+ioim5LqD5Q==" rpwd="1" auto="0"></User0>
      </USER>
    </Gateway0>
  </GATEWAY>
</SETTING_INFO>
